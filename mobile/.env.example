# Copy this file to mobile/.env and fill in the values.
#
# Expo inlines EXPO_PUBLIC_* into the JavaScript bundle at build time. All three
# values below end up inside the APK, so treat them as public: the Clerk
# publishable key and the Supabase anon key are already visible in the
# website's client bundle by design, and RLS plus Clerk are what protect the
# data.
#
# Never put a service-role key, a secret key, or any Mailgun/Paystack credential
# in this file. An APK is a file anyone can unpack.
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
EXPO_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# Updated Next.js backend origin, reachable from the phone. Local LAN builds
# infer Metro's host on port 3000 when omitted. Cloud builds require this value.
EXPO_PUBLIC_API_URL=https://your-updated-nexagear-site.example
