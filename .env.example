# Supabase — browser-safe values
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Supabase — SERVER ONLY, never expose to the browser
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Mailgun — SERVER ONLY, never expose to the browser
MAILGUN_API_KEY=key-your-mailgun-api-key
MAILGUN_DOMAIN=mg.your-domain.com
MAILGUN_FROM_EMAIL=NexaGear <orders@mg.your-domain.com>

# Site origin (OAuth redirects, canonical URLs)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
