# NexaGear environment template — copy to .env.local and fill real values.
# Never commit real values.

# Supabase — browser-safe values (database only; auth moved to Clerk, D18)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Supabase — SERVER ONLY, never expose to the browser
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Clerk — browser-safe (publishable key + route defaults)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_your-publishable-key
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# Clerk — SERVER ONLY, never expose to the browser
CLERK_SECRET_KEY=sk_test_your-secret-key

# Mailgun — SERVER ONLY, never expose to the browser
MAILGUN_API_KEY=key-your-mailgun-api-key
MAILGUN_DOMAIN=mg.your-domain.com
MAILGUN_FROM_EMAIL=NexaGear <orders@mg.your-domain.com>

# Site origin (canonical URLs)
NEXT_PUBLIC_SITE_URL=http://localhost:3000


# Paystack - SERVER ONLY, never expose to the browser.
# TEST MODE ONLY (D22): an sk_live_ key is rejected at runtime on purpose
# so this build can never charge a real card.
PAYSTACK_SECRET_KEY=sk_test_your-test-secret-key

# Upstash Redis - SERVER ONLY, never expose to the browser (D26).
# Rate limiting for checkout and the payment callback. Uses the REST API via
# plain fetch, so no extra npm package is required. Leave unset and the limiter
# fails OPEN (requests allowed, failures logged) - it is abuse protection, not
# an authorisation control, so an outage here must not block checkout.
UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-rest-token
